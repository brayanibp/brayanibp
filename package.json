{
  "name": "brayanibp-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:deploy": "playwright test --config=playwright.deploy.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-client-secrets.mjs && pnpm security:audit",
    "security:audit": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.5",
    "@types/mdx": "2.0.14",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.41.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "1.66.0",
    "mermaid": "12.3.0",
    "next": "16.4.5",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-google-recaptcha": "3.1.0",
    "react-syntax-highlighter": "16.1.2",
    "remark-gfm": "4.0.1",
    "resend": "6.37.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-google-recaptcha": "2.1.9",
    "@types/react-syntax-highlighter": "15.5.13",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
